generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Album {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  description String
  manifesto   String?
  coverImage  String
  heroImage   String?
  releaseDate DateTime?
  status      String    @default("draft")
  featured    Boolean   @default(false)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tracks      Track[]
}

model Track {
  id          String    @id @default(cuid())
  albumId     String
  title       String
  description String?
  audioUrl    String?
  duration    Int?
  trackNumber Int       @default(1)
  published   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  album       Album     @relation(fields: [albumId], references: [id], onDelete: Cascade)
  likes       Like[]
  comments    Comment[]
}

model Like {
  id        String   @id @default(cuid())
  trackId   String
  visitorId String
  createdAt DateTime @default(now())
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([trackId, visitorId])
}

model Comment {
  id        String   @id @default(cuid())
  trackId   String
  author    String
  body      String
  approved  Boolean  @default(true)
  createdAt DateTime @default(now())
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
}

model News {
  id        String    @id @default(cuid())
  kind      String    @default("novedad")
  title     String
  excerpt   String
  body      String?
  image     String?
  eventDate DateTime?
  published Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
